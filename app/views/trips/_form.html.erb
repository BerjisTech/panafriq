<%= form_with(model: trip) do |form| %>
  <% if trip.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(trip.errors.count, "error") %> prohibited this trip from being saved:</h2>

      <ul>
        <% trip.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :truck_id, style: "display: block" %>
    <%= form.text_field :truck_id %>
  </div>

  <div>
    <%= form.label :driver_id, style: "display: block" %>
    <%= form.text_field :driver_id %>
  </div>

  <div>
    <%= form.label :departure, style: "display: block" %>
    <%= form.text_area :departure %>
  </div>

  <div>
    <%= form.label :destination, style: "display: block" %>
    <%= form.text_area :destination %>
  </div>

  <div>
    <%= form.label :trip_date, style: "display: block" %>
    <%= form.datetime_field :trip_date %>
  </div>

  <div>
    <%= form.label :departure_time, style: "display: block" %>
    <%= form.datetime_field :departure_time %>
  </div>

  <div>
    <%= form.label :arrival_time, style: "display: block" %>
    <%= form.datetime_field :arrival_time %>
  </div>

  <div>
    <%= form.label :goods_status, style: "display: block" %>
    <%= form.text_field :goods_status %>
  </div>

  <div>
    <%= form.label :customer_pay, style: "display: block" %>
    <%= form.text_field :customer_pay %>
  </div>

  <div>
    <%= form.label :fine, style: "display: block" %>
    <%= form.text_field :fine %>
  </div>

  <div>
    <%= form.label :final_truck_pay, style: "display: block" %>
    <%= form.text_field :final_truck_pay %>
  </div>

  <div>
    <%= form.label :trucker_pay, style: "display: block" %>
    <%= form.text_field :trucker_pay %>
  </div>

  <div>
    <%= form.label :driver_cut, style: "display: block" %>
    <%= form.text_field :driver_cut %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
