<div id="<%= dom_id trip %>">
  <p>
    <strong>Truck:</strong>
    <%= trip.truck_id %>
  </p>

  <p>
    <strong>Driver:</strong>
    <%= trip.driver_id %>
  </p>

  <p>
    <strong>Departure:</strong>
    <%= trip.departure %>
  </p>

  <p>
    <strong>Destination:</strong>
    <%= trip.destination %>
  </p>

  <p>
    <strong>Trip date:</strong>
    <%= trip.trip_date %>
  </p>

  <p>
    <strong>Departure time:</strong>
    <%= trip.departure_time %>
  </p>

  <p>
    <strong>Arrival time:</strong>
    <%= trip.arrival_time %>
  </p>

  <p>
    <strong>Goods status:</strong>
    <%= trip.goods_status %>
  </p>

  <p>
    <strong>Customer pay:</strong>
    <%= trip.customer_pay %>
  </p>

  <p>
    <strong>Fine:</strong>
    <%= trip.fine %>
  </p>

  <p>
    <strong>Final truck pay:</strong>
    <%= trip.final_truck_pay %>
  </p>

  <p>
    <strong>Trucker pay:</strong>
    <%= trip.trucker_pay %>
  </p>

  <p>
    <strong>Driver cut:</strong>
    <%= trip.driver_cut %>
  </p>

</div>
