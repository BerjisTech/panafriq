<div id="<%= dom_id service %>">
  <p>
    <strong>Name:</strong>
    <%= service.name %>
  </p>

  <p>
    <strong>Price:</strong>
    <%= service.price %>
  </p>

  <p>
    <strong>Company:</strong>
    <%= service.company_id %>
  </p>

  <p>
    <strong>Description:</strong>
    <%= service.description %>
  </p>

  <p>
    <strong>Category:</strong>
    <%= service.category %>
  </p>

  <p>
    <strong>Offered locations:</strong>
    <%= service.offered_locations %>
  </p>

  <p>
    <strong>Quantity:</strong>
    <%= service.quantity %>
  </p>

  <p>
    <strong>Available:</strong>
    <%= service.available %>
  </p>

</div>
