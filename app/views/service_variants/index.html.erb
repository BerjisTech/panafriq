<p style="color: green"><%= notice %></p>

<h1>Service variants</h1>

<div id="service_variants">
  <% @service_variants.each do |service_variant| %>
    <%= render service_variant %>
    <p>
      <%= link_to "Show this service variant", service_variant %>
    </p>
  <% end %>
</div>

<%= link_to "New service variant", new_service_variant_path %>
