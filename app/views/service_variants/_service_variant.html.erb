<div id="<%= dom_id service_variant %>">
  <p>
    <strong>Service:</strong>
    <%= service_variant.service_id %>
  </p>

  <p>
    <strong>Name:</strong>
    <%= service_variant.name %>
  </p>

  <p>
    <strong>Price:</strong>
    <%= service_variant.price %>
  </p>

  <p>
    <strong>Company:</strong>
    <%= service_variant.company_id %>
  </p>

  <p>
    <strong>Description:</strong>
    <%= service_variant.description %>
  </p>

  <p>
    <strong>Category:</strong>
    <%= service_variant.category %>
  </p>

  <p>
    <strong>Offered locations:</strong>
    <%= service_variant.offered_locations %>
  </p>

  <p>
    <strong>Quantity:</strong>
    <%= service_variant.quantity %>
  </p>

  <p>
    <strong>Available:</strong>
    <%= service_variant.available %>
  </p>

</div>
