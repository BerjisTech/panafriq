<div id="<%= dom_id sale %>">
  <p>
    <strong>Company:</strong>
    <%= sale.company_id %>
  </p>

  <p>
    <strong>Is product:</strong>
    <%= sale.is_product %>
  </p>

  <p>
    <strong>Is service:</strong>
    <%= sale.is_service %>
  </p>

  <p>
    <strong>Products:</strong>
    <%= sale.products %>
