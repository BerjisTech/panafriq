<div id="<%= dom_id staff %>">
  <p>
    <strong>User:</strong>
    <%= staff.user_id %>
  </p>

  <p>
    <strong>Company:</strong>
    <%= staff.company_id %>
  </p>

  <p>
    <strong>Invited on:</strong>
    <%= staff.invited_on %>
  </p>

  <p>
    <strong>Joined on:</strong>
    <%= staff.joined_on %>
  </p>

  <p>
    <strong>Is active:</strong>
    <%= staff.is_active %>
  </p>

  <p>
    <strong>Left on:</strong>
    <%= staff.left_on %>
  </p>

  <p>
    <strong>Reason for leaving:</strong>
    <%= staff.reason_for_leaving %>
  </p>

  <p>
    <strong>Staff designation:</strong>
    <%= staff.staff_designation %>
  </p>

  <p>
    <strong>Invited by:</strong>
    <%= staff.invited_by %>
  </p>

</div>
