<div id="<%= dom_id truck_staff %>">
  <p>
    <strong>User:</strong>
    <%= truck_staff.user_id %>
  </p>

  <p>
    <strong>Trucker:</strong>
    <%= truck_staff.trucker_id %>
  </p>

  <p>
    <strong>Invited on:</strong>
    <%= truck_staff.invited_on %>
  </p>

  <p>
    <strong>Joined on:</strong>
    <%= truck_staff.joined_on %>
  </p>

  <p>
    <strong>Is active:</strong>
    <%= truck_staff.is_active %>
  </p>

  <p>
    <strong>Left on:</strong>
    <%= truck_staff.left_on %>
  </p>

  <p>
    <strong>Reason for leaving:</strong>
    <%= truck_staff.reason_for_leaving %>
  </p>

  <p>
    <strong>Staff designation:</strong>
    <%= truck_staff.staff_designation %>
  </p>

  <p>
    <strong>Invited by:</strong>
    <%= truck_staff.invited_by %>
  </p>

</div>
