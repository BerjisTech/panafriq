<%= form_with(model: storage_type) do |form| %>
  <% if storage_type.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(storage_type.errors.count, "error") %> prohibited this storage_type from being saved:</h2>

      <ul>
        <% storage_type.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :text, style: "display: block" %>
