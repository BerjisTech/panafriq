<div id="<%= dom_id storage_staff %>">
  <p>
    <strong>User:</strong>
    <%= storage_staff.user_id %>
  </p>

  <p>
    <strong>Storage:</strong>
    <%= storage_staff.storage_id %>
  </p>

  <p>
    <strong>Invited on:</strong>
    <%= storage_staff.invited_on %>
  </p>

  <p>
    <strong>Joined on:</strong>
    <%= storage_staff.joined_on %>
  </p>

  <p>
    <strong>Is active:</strong>
    <%= storage_staff.is_active %>
  </p>

  <p>
    <strong>Left on:</strong>
    <%= storage_staff.left_on %>
  </p>

  <p>
    <strong>Reason for leaving:</strong>
    <%= storage_staff.reason_for_leaving %>
  </p>

  <p>
    <strong>Staff designation:</strong>
    <%= storage_staff.staff_designation %>
  </p>

  <p>
    <strong>Invited by:</strong>
    <%= storage_staff.invited_by %>
  </p>

</div>
