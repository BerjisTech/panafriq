<%= form_with(model: trucker) do |form| %>
  <% if trucker.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(trucker.errors.count, "error") %> prohibited this trucker from being saved:</h2>

      <ul>
        <% trucker.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :user_id, style: "display: block" %>
