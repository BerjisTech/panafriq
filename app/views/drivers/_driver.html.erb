<div id="<%= dom_id driver %>">
  <p>
    <strong>User:</strong>
    <%= driver.user_id %>
  </p>

  <p>
    <strong>Trucker:</strong>
    <%= driver.trucker_id %>
  </p>

  <p>
    <strong>Invited on:</strong>
    <%= driver.invited_on %>
  </p>

  <p>
    <strong>Joined on:</strong>
    <%= driver.joined_on %>
  </p>

  <p>
    <strong>Is active:</strong>
    <%= driver.is_active %>
  </p>

  <p>
    <strong>Left on:</strong>
    <%= driver.left_on %>
  </p>

  <p>
    <strong>Reason for leaving:</strong>
    <%= driver.reason_for_leaving %>
  </p>

  <p>
    <strong>Staff designation:</strong>
    <%= driver.staff_designation %>
  </p>

  <p>
    <strong>Invited by:</strong>
    <%= driver.invited_by %>
  </p>

</div>
